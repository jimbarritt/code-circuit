{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jimbarritt/code-circuit/schema/data-map.schema.json",
  "title": "Data map",
  "description": "A service as a graph: endpoints enter it, nodes are chips, edges are calls, externals are systems outside it.",
  "type": "object",
  "required": ["endpoints", "nodes", "edges", "externals"],
  "properties": {
    "system": { "type": "string" },
    "language": { "type": "string" },
    "framework": { "type": "string" },
    "captured": { "type": "string" },
    "endpoints": { "type": "array", "items": { "$ref": "#/definitions/endpoint" } },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
    "externals": { "type": "array", "items": { "$ref": "#/definitions/external" } }
  },
  "additionalProperties": true,
  "definitions": {
    "id": { "type": "string", "minLength": 1 },
    "endpoint": {
      "type": "object",
      "required": ["id", "method", "path", "entry"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "entry": { "$ref": "#/definitions/id", "description": "Id of the node that handles the endpoint." }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1, "description": "For example controller, service, model, worker, adapter." },
        "file": { "type": "string" },
        "queue": { "type": "string", "description": "Queue a worker node reads from." }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["sync", "async", "io"] },
        "queue": { "type": "string", "description": "Queue name. Required on async edges." },
        "rule": { "type": "string", "description": "The extraction rule that produced the edge." }
      },
      "if": { "properties": { "kind": { "const": "async" } }, "required": ["kind"] },
      "then": { "required": ["queue"] },
      "additionalProperties": true
    },
    "external": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
